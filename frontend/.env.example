# Backend API base URL (must include the /api suffix).
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Public site URL (used for metadata, sitemap, robots).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Sign-In (optional). The Web OAuth Client ID from Google Cloud Console.
# Must match GOOGLE_OAUTH_CLIENT_ID on the backend. Add your site origin(s) to
# the client's "Authorized JavaScript origins". Leave blank to hide/disable the
# working Google button (a placeholder is shown instead).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Auth page background video (optional). Defaults to the bundled space clip.
# NEXT_PUBLIC_AUTH_VIDEO_URL=
# NEXT_PUBLIC_AUTH_VIDEO_POSTER=
