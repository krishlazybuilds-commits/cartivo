    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "marked": "^18.0.5",
    "next": "^15.5.16",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "sanitize-html": "^2.17.5"
  },
  "overrides": {
    "postcss": "^8.5.10",
    "esbuild": ">=0.28.1",
    "form-data": "^4.0.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.9",
    "jsdom": "^25.0.1",
    "typescript": "^6.0.3",
    "vitest": "^3.2.6"
