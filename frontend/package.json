{
  "name": "cartivo-landing",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "clean": "Remove-Item -Recurse -Force .next -ErrorAction SilentlyContinue",
