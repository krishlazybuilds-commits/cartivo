# ---- Cartivo monorepo root .gitignore ----
# App-specific ignores live in backend/.gitignore and frontend/.gitignore.
# This file covers shared OS, editor, and tooling artifacts.

# Environment files (never commit secrets)
.env
.env.*
!.env.example

# Python (backend)
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.sqlite3
*.sqlite3-journal

# Node (frontend)
node_modules/
.next/
out/
dist/
build/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Editors / IDEs
.idea/
.vscode/
*.swp
*~
