# Django core
DJANGO_SECRET_KEY=change-me-to-a-long-random-string  # generate: python -c "import secrets; print(secrets.token_urlsafe(50))"
# True for local development only. ALWAYS set False in production — when unset,
# the app now defaults to False (production-safe).
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=UTC

# JWT lifetimes
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# CORS (frontend origins, comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Cache / rate-limit store. Leave unset for local dev (in-memory). In production
# with multiple workers, set this so throttling is shared across processes.
# REDIS_URL=redis://localhost:6379/0
# Optional Redis client tuning (only used when REDIS_URL is set):
# REDIS_SOCKET_CONNECT_TIMEOUT=5
# REDIS_SOCKET_TIMEOUT=5
# REDIS_HEALTH_CHECK_INTERVAL=30

# Celery background tasks (order/payment emails, webhook side-effects).
# Defaults to REDIS_URL. When no broker is configured, tasks run inline
# (eager) so the app works without a worker. Run a worker with:
#   celery -A config worker --loglevel=info
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=
# CELERY_TASK_ALWAYS_EAGER=False
# CELERY_TASK_TIME_LIMIT=120
# CELERY_TASK_SOFT_TIME_LIMIT=90

# Pending-order expiry (Celery Beat). Cancels + restocks unpaid PENDING orders
# older than ORDER_EXPIRY_MINUTES, checked every ORDER_EXPIRY_CHECK_SECONDS.
# Requires a running beat scheduler: celery -A config beat --loglevel=info
# ORDER_EXPIRY_MINUTES=30
# ORDER_EXPIRY_CHECK_SECONDS=300

# Media storage (user uploads). Leave USE_S3 unset/False for local dev (stores
# on the local filesystem). Set USE_S3=True to use any S3-compatible object
# store — AWS S3, Cloudflare R2, Backblaze B2, or the bundled free MinIO
# (docker compose). docker-compose already wires these for MinIO; set them here
# only when running the backend outside compose.
# USE_S3=False
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=cartivo-media
# AWS_S3_REGION_NAME=
# Custom endpoint for non-AWS providers (R2/B2/MinIO); leave unset for AWS S3.
# AWS_S3_ENDPOINT_URL=
# Public host for building media URLs (CDN domain, or host:port/bucket).
# AWS_S3_CUSTOM_DOMAIN=
# AWS_S3_URL_PROTOCOL=https:
# AWS_S3_USE_SSL=True
# AWS_S3_ADDRESSING_STYLE=path
# AWS_QUERYSTRING_AUTH=False

# MinIO credentials (used by docker-compose's bundled object storage).
# MINIO_ROOT_USER=minioadmin
# MINIO_ROOT_PASSWORD=minioadmin

# Error monitoring (optional). Leave unset to disable Sentry.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.0

# Logging level (DEBUG, INFO, WARNING, ERROR)
# DJANGO_LOG_LEVEL=INFO

# Auth cookies (JWTs are stored in httpOnly cookies)
#   AUTH_COOKIE_SECURE: must be True in production (HTTPS). Defaults to True when DEBUG=False.
#   AUTH_COOKIE_SAMESITE: "Lax" if frontend+backend share a parent domain; "None" if on
#     fully different domains (then AUTH_COOKIE_SECURE must be True / HTTPS).
#   AUTH_COOKIE_DOMAIN: set to a shared parent domain like ".example.com" when the
#     frontend and backend are on different subdomains. Leave blank for local dev.
# AUTH_COOKIE_SECURE=False
# AUTH_COOKIE_SAMESITE=Lax
# AUTH_COOKIE_DOMAIN=

# CSRF trusted origins (frontend origins that may POST, comma-separated)
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Google Sign-In (optional). Create a Web OAuth Client ID in Google Cloud
# Console (APIs & Services > Credentials). Add your frontend origin(s) to
# "Authorized JavaScript origins" (e.g. http://localhost:3000). Leave blank to
# disable Google sign-in. The same client ID must be set on the frontend as
# NEXT_PUBLIC_GOOGLE_CLIENT_ID.
GOOGLE_OAUTH_CLIENT_ID=

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Email (SMTP)
# In DEBUG mode the console backend is used by default — no SMTP needed.
# For real sending, set EMAIL_BACKEND to smtp and fill the rest:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=you@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=Cartivo <you@gmail.com>

# Database — leave DB_ENGINE unset to use SQLite.
# For PostgreSQL, uncomment and fill these:
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=cartivo
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_HOST=localhost
# DB_PORT=5432
