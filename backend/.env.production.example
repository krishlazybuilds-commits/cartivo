# ==============================================================================
# Cartivo backend — PRODUCTION environment template (.env.production.example)
# ==============================================================================
# Copy to .env.production and fill in real values for your deployment.
#
# IMPORTANT:
#   * Secrets (SECRET_KEY, DB password, Stripe keys, email/app passwords) must
#     be INJECTED by your deployment platform / secrets manager — do NOT commit
#     a filled-in copy of this file.
#   * The app MUST run behind TLS (HTTPS). With DJANGO_DEBUG=False the security
#     hardening auto-enables: SECURE_SSL_REDIRECT and HSTS are turned on, and
#     session/auth/CSRF cookies are marked Secure. Terminate TLS at your
#     proxy/load balancer and forward X-Forwarded-Proto=https.
#   * Keep DJANGO_DEBUG=False here. DEBUG=True leaks tracebacks/settings/SQL and
#     disables the secure-cookie/HSTS hardening; the app refuses to boot in
#     DEBUG mode against a non-local DJANGO_ALLOWED_HOSTS.

# Django core
# Generate a strong key: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=replace-with-a-strong-randomly-generated-secret
# MUST be False in production (production-safe default; never set True here).
DJANGO_DEBUG=False
# Real public hostname(s) of the deployment, comma-separated. No wildcards.
DJANGO_ALLOWED_HOSTS=your.domain.com
DJANGO_TIME_ZONE=UTC

# JWT lifetimes
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# CORS (frontend origins allowed to call the API, comma-separated, https)
CORS_ALLOWED_ORIGINS=https://your.domain.com

# CSRF trusted origins (frontend origins that may POST, comma-separated, https)
CSRF_TRUSTED_ORIGINS=https://your.domain.com

# Auth cookies — MUST be True in production (cookies sent over HTTPS only).
#   AUTH_COOKIE_SAMESITE: "Lax" if frontend+backend share a parent domain;
#     "None" if on fully different domains (requires Secure=True / HTTPS).
#   AUTH_COOKIE_DOMAIN: set to a shared parent domain like ".your.domain.com"
#     when the frontend and backend are on different subdomains.
AUTH_COOKIE_SECURE=True
AUTH_COOKIE_SAMESITE=Lax
# AUTH_COOKIE_DOMAIN=.your.domain.com

# Cache / rate-limit store and Celery broker. Required in production so
# throttling and background tasks are shared across multiple workers.
REDIS_URL=redis://redis:6379/0
# CELERY_BROKER_URL defaults to REDIS_URL; override if using a separate broker.
# CELERY_BROKER_URL=redis://redis:6379/0
# CELERY_RESULT_BACKEND=

# Database — PostgreSQL (inject the password via your secrets manager).
DB_ENGINE=django.db.backends.postgresql
DB_NAME=cartivo
DB_USER=postgres
DB_PASSWORD=replace-with-db-password
DB_HOST=db
DB_PORT=5432

# Stripe (use live keys in production; inject via secrets manager).
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Email (SMTP). In production the SMTP backend is used by default.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.your-provider.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=no-reply@your.domain.com
EMAIL_HOST_PASSWORD=replace-with-smtp-password
DEFAULT_FROM_EMAIL=Cartivo <no-reply@your.domain.com>

# Google Sign-In (optional). Web OAuth Client ID from Google Cloud Console.
# Leave blank to disable. Must match NEXT_PUBLIC_GOOGLE_CLIENT_ID on the frontend.
GOOGLE_OAUTH_CLIENT_ID=
